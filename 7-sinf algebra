    </header>

    <!-- Main Content Area -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-8">

        <!-- ========================================== -->
        <!-- 1. DARSLIK (NAZARIYA) BO'LIMI              -->
        <!-- ========================================== -->
        <section id="section-theory" class="fade-in space-y-8">
            <!-- Hero Intro Banner -->
            <div class="bg-gradient-to-r from-indigo-600 via-indigo-700 to-violet-700 rounded-2xl p-6 sm:p-8 text-white shadow-lg relative overflow-hidden">
                <div class="relative z-10 max-w-2xl">
                    <span class="inline-block px-3 py-1 bg-white/15 backdrop-blur-sm rounded-full text-xs font-semibold mb-3">
                        1-Bob • Nazariy asoslar
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold mb-2">Algebraik ifodalarni soddalashtirish va tenglamalar</h2>
                    <p class="text-indigo-100 text-sm sm:text-base leading-relaxed">
                        Murakkab tenglamalarni oson yechish uchun avval qavslarni to'g'ri ochishni va o'xshash hadlarni ixchamlashni mukammal o'rganib olamiz.
                    </p>
                </div>
                <!-- Decorative background math symbols -->
                <div class="hidden sm:block absolute right-8 top-1/2 -translate-y-1/2 font-mono text-7xl font-bold text-white/10 select-none">
                    2(x+3)=10
                </div>
            </div>

            <!-- Topic Cards Grid -->
            <div class="grid grid-cols-1 gap-6">

                <!-- MAVZU 1: O'xshash hadlarni ixchamlash -->
                <article class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-7 shadow-sm">
                    <div class="flex items-start gap-4 mb-4">
                        <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center font-extrabold text-lg shrink-0">
                            1
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-slate-900">O'xshash hadlarni ixchamlash</h3>
                            <p class="text-slate-500 text-sm mt-0.5">Bir xil harfiy qismga ega bo'lgan hadlarni qo'shish va ayirish</p>
                        </div>
                    </div>

                    <div class="bg-blue-50/70 border-l-4 border-blue-500 p-4 rounded-r-xl mb-5">
                        <p class="text-sm sm:text-base text-slate-800 font-medium">
                            <strong class="text-blue-700">Qoida:</strong> Harfiy qismlari bir xil bo'lgan hadlar <strong>o'xshash hadlar</strong> deyiladi. Ularni ixchamlash uchun koeffitsiyentlari (oldindagi sonlar) qo'shiladi va umumiy harfiy qismga ko'paytiriladi.
                        </p>
                    </div>

                    <!-- Color-coded visual breakdown -->
                    <div class="bg-slate-50 rounded-xl p-5 border border-slate-200/80 space-y-4">
                        <div class="text-xs font-bold uppercase tracking-wider text-slate-400">Misol va vizual tahlil:</div>
                        
                        <div class="math-expr text-base sm:text-lg bg-white p-4 rounded-xl border border-slate-200 overflow-x-auto">
                            <span class="px-2 py-0.5 rounded bg-indigo-100 text-indigo-800 font-bold">5x</span> + 
                            <span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold">7</span> − 
                            <span class="px-2 py-0.5 rounded bg-indigo-100 text-indigo-800 font-bold">2x</span> − 
                            <span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold">3</span>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
                            <div class="flex items-center gap-3 bg-indigo-50/80 p-3 rounded-lg border border-indigo-100">
                                <span class="w-3 h-3 rounded-full bg-indigo-500 shrink-0"></span>
                                <div>
                                    <span class="text-slate-600">Noma'lumli hadlar:</span>
                                    <div class="math-expr font-bold text-indigo-900">5x − 2x = (5 − 2)x = 3x</div>
                                </div>
                            </div>
                            <div class="flex items-center gap-3 bg-emerald-50/80 p-3 rounded-lg border border-emerald-100">
                                <span class="w-3 h-3 rounded-full bg-emerald-500 shrink-0"></span>
                                <div>
                                    <span class="text-slate-600">Ozod hadlar (sonlar):</span>
                                    <div class="math-expr font-bold text-emerald-900">7 − 3 = 4</div>
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center justify-between pt-2 border-t border-slate-200">
                            <span class="text-sm font-semibold text-slate-600">Yakuniy soddalashgan javob:</span>
                            <span class="math-expr text-lg font-extrabold text-indigo-600 bg-indigo-50 px-3 py-1 rounded-lg">3x + 4</span>
                        </div>
                    </div>
                </article>

                <!-- MAVZU 2: Qavslarni ochish qoidalari -->
                <article class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-7 shadow-sm">
                    <div class="flex items-start gap-4 mb-4">
                        <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-600 flex items-center justify-center font-extrabold text-lg shrink-0">
                            2
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-slate-900">Qavslarni ochish qoidalari</h3>
                            <p class="text-slate-500 text-sm mt-0.5">Musbat (+), manfiy (−) ishoralar va ko'paytirishning taqsimot qonuni</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-5">
                        <!-- Rule A -->
                        <div class="bg-emerald-50/60 border border-emerald-200 rounded-xl p-4">
                            <div class="text-xs font-bold text-emerald-700 uppercase mb-1">1-holat: "+" ishorasi</div>
                            <p class="text-xs text-slate-600 mb-2">Qavs oldida <strong>+</strong> bo'lsa, ichidagi ishoralar <strong>o'zgarmaydi</strong>.</p>
                            <div class="math-expr text-sm font-bold text-slate-800 bg-white p-2.5 rounded-lg border border-emerald-100">
                                a + (b − c) = a + b − c
                            </div>
                        </div>
                        <!-- Rule B -->
                        <div class="bg-rose-50/60 border border-rose-200 rounded-xl p-4">
                            <div class="text-xs font-bold text-rose-700 uppercase mb-1">2-holat: "−" ishorasi</div>
                            <p class="text-xs text-slate-600 mb-2">Qavs oldida <strong>−</strong> bo'lsa, barcha ishoralar <strong>qarama-qarshisiga</strong> o'zgaradi!</p>
                            <div class="math-expr text-sm font-bold text-slate-800 bg-white p-2.5 rounded-lg border border-rose-100">
                                a − (b − c) = a − b <span class="text-rose-600 underline">+</span> c
                            </div>
                        </div>
                        <!-- Rule C -->
                        <div class="bg-amber-50/60 border border-amber-200 rounded-xl p-4">
                            <div class="text-xs font-bold text-amber-700 uppercase mb-1">3-holat: Taqsimot qonuni</div>
                            <p class="text-xs text-slate-600 mb-2">Qavs tashqarisidagi son ichidagi <strong>har bir</strong> hadga ko'paytiriladi.</p>
                            <div class="math-expr text-sm font-bold text-slate-800 bg-white p-2.5 rounded-lg border border-amber-100">
                                a(b + c) = ab + ac
                            </div>
                        </div>
                    </div>

                    <!-- Worked Example for Parentheses -->
                    <div class="bg-slate-50 rounded-xl p-5 border border-slate-200/80">
                        <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Amaliy misol:</div>
                        <div class="space-y-2.5 math-expr text-sm sm:text-base">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="text-slate-500 font-sans text-xs font-bold w-24">Berilgan:</span>
                                <span class="font-bold text-slate-900">4(2x − 1) − 3(x − 2)</span>
                            </div>
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="text-slate-500 font-sans text-xs font-bold w-24">1-qadam:</span>
                                <span class="text-slate-700">8x − 4 − 3x <span class="px-1.5 py-0.5 bg-rose-100 text-rose-700 font-bold rounded">+ 6</span> <span class="font-sans text-xs text-rose-600">(−3 · (−2) = +6!)</span></span>
                            </div>
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="text-slate-500 font-sans text-xs font-bold w-24">2-qadam:</span>
                                <span class="text-slate-700">(8x − 3x) + (−4 + 6)</span>
                            </div>
                            <div class="flex flex-wrap items-center gap-2 pt-1">
                                <span class="text-slate-500 font-sans text-xs font-bold w-24">Javob:</span>
                                <span class="font-extrabold text-purple-700 bg-purple-100 px-3 py-1 rounded-lg">5x + 2</span>
                            </div>
                        </div>
                    </div>
                </article>

                <!-- MAVZU 3: Chiziqli tenglamalarni yechish -->
                <article class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-7 shadow-sm">
                    <div class="flex items-start gap-4 mb-4">
                        <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center font-extrabold text-lg shrink-0">
                            3
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-slate-900">Chiziqli tenglamalarni yechish</h3>
                            <p class="text-slate-500 text-sm mt-0.5">Hadlarni tenglik belgisining bir tomonidan ikkinchi tomoniga o'tkazish qoidasi</p>
                        </div>
                    </div>

                    <div class="bg-emerald-50/70 border-l-4 border-emerald-500 p-4 rounded-r-xl mb-5">
                        <p class="text-sm sm:text-base text-slate-800 font-medium">
                            <strong class="text-emerald-700">Oltin qoida:</strong> Tenglamadagi biror hadni tenglik belgisining (<strong>=</strong>) bir tomonidan ikkinchi tomoniga o'tkazganda, uning ishorasi <strong>qarama-qarshisiga o'zgaradi</strong> (masalan, <strong>+</strong> bo'lsa <strong>−</strong> ga, <strong>−</strong> bo'lsa <strong>+</strong> ga).
                        </p>
                    </div>

                    <!-- Step-by-step equation solution -->
                    <div class="bg-slate-50 rounded-xl p-5 border border-slate-200/80">
                        <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Tenglama yechish algoritmi:</div>
                        <div class="space-y-3">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between bg-white p-3.5 rounded-xl border border-slate-200 gap-2">
                                <span class="text-xs font-bold text-slate-500">Boshlang'ich tenglama:</span>
                                <span class="math-expr text-base sm:text-lg font-bold text-slate-900">2(x − 3) + 4x = 18</span>
                            </div>
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between bg-white p-3.5 rounded-xl border border-slate-200 gap-2">
                                <span class="text-xs font-bold text-indigo-600">1. Qavsni ochamiz:</span>
                                <span class="math-expr text-base font-semibold text-slate-800">2x − 6 + 4x = 18</span>
                            </div>
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between bg-white p-3.5 rounded-xl border border-slate-200 gap-2">
                                <span class="text-xs font-bold text-indigo-600">2. O'xshash hadlarni ixchamlaymiz:</span>
                                <span class="math-expr text-base font-semibold text-slate-800">6x − 6 = 18</span>
                            </div>
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between bg-white p-3.5 rounded-xl border border-slate-200 gap-2">
                                <span class="text-xs font-bold text-rose-600">3. "−6" ni o'ng tomonga "+6" qilib o'tkazamiz:</span>
                                <span class="math-expr text-base font-semibold text-slate-800">6x = 18 <span class="text-rose-600 font-bold">+ 6</span>  ⇒  6x = 24</span>
                            </div>
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between bg-emerald-50 p-3.5 rounded-xl border border-emerald-200 gap-2">
                                <span class="text-xs font-bold text-emerald-700">4. Ikkala tomonni 6 ga bo'lamiz:</span>
                                <span class="math-expr text-lg font-extrabold text-emerald-800">x = 24 ÷ 6  ⇒  x = 4</span>
                            </div>
                        </div>
                    </div>
                </article>
            </div>

            <!-- CTA to Practice -->
            <div class="bg-white border border-slate-200 rounded-2xl p-6 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-sm">
                <div>
                    <h4 class="font-bold text-slate-900 text-lg">Qoidalarni tushunib oldingizmi?</h4>
                    <p class="text-sm text-slate-500">Endi interaktiv trenajyorda bilimingizni mustahkamlang!</p>
                </div>
                <button onclick="switchTab('practice')" class="w-full sm:w-auto px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-md transition-all flex items-center justify-center gap-2">
                    <span>Mashqlarni boshlash</span>
                    <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </button>
            </div>
        </section>

        <!-- ========================================== -->
        <!-- 2. AMALIY MASHQ (TRENAJYOR) BO'LIMI        -->
        <!-- ========================================== -->
        <section id="section-practice" class="hidden fade-in space-y-6">
            <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm">
                <!-- Top Controls: Difficulty & Stats -->
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-slate-100">
                    <div>
                        <h2 class="text-2xl font-extrabold text-slate-900">Interaktiv Trenajyor</h2>
                        <p class="text-sm text-slate-500 mt-0.5">Qiyinlik darajasini tanlang va misollarni bosqichma-bosqich yeching</p>
                    </div>

                    <!-- Difficulty Selector -->
                    <div class="flex items-center gap-2 bg-slate-100 p-1.5 rounded-xl">
                        <button onclick="setDifficulty('easy')" id="diff-easy" class="diff-btn px-4 py-2 rounded-lg text-sm font-bold transition-all bg-white text-emerald-700 shadow-sm">
                            Oson
                        </button>
                        <button onclick="setDifficulty('medium')" id="diff-medium" class="diff-btn px-4 py-2 rounded-lg text-sm font-bold transition-all text-slate-600 hover:text-slate-900">
                            O'rta
                        </button>
                        <button onclick="setDifficulty('hard')" id="diff-hard" class="diff-btn px-4 py-2 rounded-lg text-sm font-bold transition-all text-slate-600 hover:text-slate-900">
                            Qiyin
                        </button>
                    </div>
                </div>

                <!-- Problem Area -->
                <div class="py-8 max-w-2xl mx-auto">
                    <div class="flex items-center justify-between mb-3">
                        <span id="practice-type-badge" class="px-3 py-1 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-100">
                            Ifodani soddalashtiring
                        </span>
                        <span class="text-xs font-semibold text-slate-400">
                            Yechilgan: <strong id="practice-solved-count" class="text-slate-700">0</strong> ta
                        </span>
                    </div>

                    <!-- Math Problem Card -->
                    <div class="bg-slate-900 text-white rounded-2xl p-6 sm:p-8 text-center shadow-lg mb-6 relative overflow-hidden">
                        <div class="text-xs uppercase tracking-widest text-slate-400 font-semibold mb-2" id="practice-instruction">
                            O'xshash hadlarni ixchamlang:
                        </div>
                        <div id="practice-problem-text" class="math-expr text-2xl sm:text-4xl font-bold tracking-tight text-white py-2">
                            4x + 7x − 3x
                        </div>
                    </div>

                    <!-- Answer Input & Actions -->
                    <form onsubmit="checkPracticeAnswer(event)" class="space-y-4">
                        <div>
                            <label for="practice-input" class="block text-sm font-bold text-slate-700 mb-2" id="practice-input-label">
                                Soddalashgan ifodani kiriting (masalan: 8x yoki 3x + 5):
                            </label>
                            <div class="flex flex-col sm:flex-row gap-3">
                                <input 
                                    type="text" 
                                    id="practice-input" 
                                    autocomplete="off"
                                    placeholder="Javobingizni yozing..." 
                                    class="math-expr flex-1 px-4 py-3.5 text-lg font-bold rounded-xl border-2 border-slate-200 focus:border-indigo-600 focus:outline-none transition-colors"
                                >
                                <button type="submit" class="px-6 py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-md transition-all flex items-center justify-center gap-2 shrink-0">
                                    <i data-lucide="check" class="w-5 h-5"></i>
                                    <span>Tekshirish</span>
                                </button>
                            </div>
                        </div>
                    </form>

                    <!-- Feedback Alert Box -->
                    <div id="practice-feedback" class="hidden mt-5 p-4 rounded-xl border font-medium text-sm flex items-center gap-3"></div>

                    <!-- Secondary Buttons: Show Steps & Next Problem -->
