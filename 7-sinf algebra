        let currentQuizIndex = 0;
        let userQuizAnswers = new Array(quizQuestions.length).fill(null);
        let quizTimerInterval = null;
        let quizSecondsLeft = 15 * 60;

        function startQuiz() {
            currentQuizIndex = 0;
            userQuizAnswers = new Array(quizQuestions.length).fill(null);
            quizSecondsLeft = 15 * 60;

            document.getElementById('quiz-start-screen').classList.add('hidden');
            document.getElementById('quiz-result-screen').classList.add('hidden');
            document.getElementById('quiz-active-screen').classList.remove('hidden');

            startQuizTimer();
            renderQuizQuestion();
        }

        function startQuizTimer() {
            clearInterval(quizTimerInterval);
            updateTimerDisplay();
            quizTimerInterval = setInterval(() => {
                quizSecondsLeft--;
                updateTimerDisplay();
                if (quizSecondsLeft <= 0) {
                    clearInterval(quizTimerInterval);
                    finishQuiz();
                }
            }, 1000);
        }

        function updateTimerDisplay() {
            const mins = Math.floor(quizSecondsLeft / 60);
            const secs = quizSecondsLeft % 60;
            document.getElementById('quiz-timer').textContent = 
                `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
        }

        function renderQuizQuestion() {
            const q = quizQuestions[currentQuizIndex];
            document.getElementById('quiz-current-num').textContent = currentQuizIndex + 1;
            document.getElementById('quiz-q-category').textContent = q.category;
            document.getElementById('quiz-q-text').textContent = q.question;

            // Render progress dots
            const dotsContainer = document.getElementById('quiz-dots');
            dotsContainer.innerHTML = quizQuestions.map((_, idx) => {
                let colorClass = 'bg-slate-200';
                if (idx === currentQuizIndex) colorClass = 'bg-indigo-600 ring-2 ring-indigo-200';
                else if (userQuizAnswers[idx] !== null) colorClass = 'bg-emerald-500';
                return `<button onclick="jumpToQuiz(${idx})" class="w-2.5 h-2.5 rounded-full transition-all ${colorClass}" title="${idx + 1}-savol"></button>`;
            }).join('');

            // Render Options
            const letters = ['A', 'B', 'C', 'D'];
            const optionsContainer = document.getElementById('quiz-options');
            optionsContainer.innerHTML = q.options.map((opt, idx) => {
                const isSelected = userQuizAnswers[currentQuizIndex] === idx;
                const borderClass = isSelected 
                    ? 'border-indigo-600 bg-indigo-50/70 ring-1 ring-indigo-600' 
                    : 'border-slate-200 hover:border-indigo-300 hover:bg-slate-50';
                const badgeClass = isSelected
                    ? 'bg-indigo-600 text-white'
                    : 'bg-slate-100 text-slate-600';

                return `
                    <button type="button" onclick="selectQuizOption(${idx})" class="w-full text-left p-4 rounded-xl border-2 transition-all flex items-center gap-3.5 ${borderClass}">
                        <span class="w-8 h-8 rounded-lg font-extrabold text-sm flex items-center justify-center shrink-0 transition-colors ${badgeClass}">
                            ${letters[idx]}
                        </span>
                        <span class="math-expr font-bold text-slate-800 text-base">${opt}</span>
                    </button>
                `;
            }).join('');

            // Navigation buttons visibility
            document.getElementById('btn-quiz-prev').disabled = (currentQuizIndex === 0);
            if (currentQuizIndex === quizQuestions.length - 1) {
                document.getElementById('btn-quiz-next').classList.add('hidden');
                document.getElementById('btn-quiz-finish').classList.remove('hidden');
            } else {
                document.getElementById('btn-quiz-next').classList.remove('hidden');
                document.getElementById('btn-quiz-finish').classList.add('hidden');
            }
        }

        function selectQuizOption(optionIdx) {
            userQuizAnswers[currentQuizIndex] = optionIdx;
            renderQuizQuestion();
        }

        function jumpToQuiz(idx) {
            currentQuizIndex = idx;
            renderQuizQuestion();
        }

        function prevQuizQuestion() {
            if (currentQuizIndex > 0) {
                currentQuizIndex--;
                renderQuizQuestion();
            }
        }

        function nextQuizQuestion() {
            if (currentQuizIndex < quizQuestions.length - 1) {
                currentQuizIndex++;
                renderQuizQuestion();
            }
        }

        function finishQuiz() {
            clearInterval(quizTimerInterval);

            let correctCount = 0;
            quizQuestions.forEach((q, idx) => {
                if (userQuizAnswers[idx] === q.correct) correctCount++;
            });

            const wrongCount = quizQuestions.length - correctCount;
            const percent = Math.round((correctCount / quizQuestions.length) * 100);
            const earnedPoints = correctCount * 10;

            addScore(earnedPoints);

            // Update Summary UI
            document.getElementById('res-correct').textContent = `${correctCount} / 10`;
            document.getElementById('res-wrong').textContent = `${wrongCount} / 10`;
            document.getElementById('res-percent').textContent = `${percent}%`;
            document.getElementById('res-points').textContent = `+${earnedPoints}`;

            const titleEl = document.getElementById('result-title');
            const subEl = document.getElementById('result-subtitle');
            if (percent >= 80) {
                titleEl.textContent = "A'lo natija! Tabriklaymiz!";
                subEl.textContent = "Siz 7-sinf tenglamalar va ifodalarni soddalashtirish bobini a'lo darajada o'zlashtirgansiz.";
            } else if (percent >= 50) {
                titleEl.textContent = "Yaxshi harakat!";
                subEl.textContent = "Asosiy tushunchalar bor, xato qilingan savollar tahlilini ko'rib chiqing.";
            } else {
                titleEl.textContent = "Yana bir bor mashq qiling!";
                subEl.textContent = "Darslik bo'limidagi qoidalarni takrorlab, trenajyorda ko'proq misol ishlang.";
            }

            // Render Detailed Review
            const letters = ['A', 'B', 'C', 'D'];
            const reviewList = document.getElementById('quiz-review-list');
            reviewList.innerHTML = quizQuestions.map((q, idx) => {
                const userAns = userQuizAnswers[idx];
                const isCorrect = (userAns === q.correct);
                const statusBadge = isCorrect
                    ? `<span class="px-2.5 py-1 rounded-lg bg-emerald-100 text-emerald-800 text-xs font-bold flex items-center gap-1"><i data-lucide="check" class="w-3.5 h-3.5"></i> To'g'ri</span>`
                    : `<span class="px-2.5 py-1 rounded-lg bg-rose-100 text-rose-800 text-xs font-bold flex items-center gap-1"><i data-lucide="x" class="w-3.5 h-3.5"></i> Xato</span>`;

                const userAnsText = userAns !== null 
                    ? `${letters[userAns]}) ${q.options[userAns]}` 
                    : `<span class="italic text-slate-400">Javob belgilanmagan</span>`;

                return `
                    <div class="bg-white rounded-2xl border ${isCorrect ? 'border-emerald-200' : 'border-rose-200'} p-5 shadow-sm">
                        <div class="flex items-start justify-between gap-3 mb-2">
                            <span class="text-xs font-bold text-slate-400">${idx + 1}-savol • ${q.category}</span>
                            ${statusBadge}
                        </div>
                        <div class="font-bold text-slate-900 text-base mb-3">${q.question}</div>
                        
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-sm mb-3">
                            <div class="p-2.5 rounded-xl ${isCorrect ? 'bg-emerald-50 text-emerald-900 border border-emerald-200' : 'bg-rose-50 text-rose-900 border border-rose-200'}">
                                <span class="text-xs block opacity-75">Sizning javobingiz:</span>
                                <strong class="math-expr">${userAnsText}</strong>
                            </div>
                            <div class="p-2.5 rounded-xl bg-emerald-50 text-emerald-900 border border-emerald-200">
                                <span class="text-xs block opacity-75">To'g'ri javob:</span>
                                <strong class="math-expr">${letters[q.correct]}) ${q.options[q.correct]}</strong>
                            </div>
                        </div>

                        <div class="bg-slate-50 p-3 rounded-xl text-xs sm:text-sm text-slate-700 border border-slate-200/80">
                            <strong class="text-indigo-700">Izoh:</strong> ${q.explanation}
                        </div>
                    </div>
                `;
            }).join('');

            document.getElementById('quiz-active-screen').classList.add('hidden');
            document.getElementById('quiz-result-screen').classList.remove('hidden');
            lucide.createIcons();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    </script>
</body>
</html>
