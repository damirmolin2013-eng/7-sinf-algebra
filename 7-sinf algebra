    <!-- Application JavaScript Logic -->
    <script>
        // Initialize Lucide icons
        lucide.createIcons();

        // Global State
        let totalScore = 0;
        let practiceSolvedCount = 0;
        let currentDifficulty = 'easy';
        let currentPracticeProblem = null;

        // Update Score UI
        function addScore(points) {
            totalScore += points;
            document.getElementById('desktop-score').textContent = `${totalScore} ball`;
            document.getElementById('mobile-score').textContent = `${totalScore} ball`;
        }

        // Tab Switching Logic
        function switchTab(tabName) {
            const tabs = ['theory', 'practice', 'quiz'];
            tabs.forEach(t => {
                const section = document.getElementById(`section-${t}`);
                const btn = document.getElementById(`tab-${t}`);
                if (t === tabName) {
                    section.classList.remove('hidden');
                    btn.classList.add('tab-active');
                    btn.classList.remove('text-slate-600', 'hover:text-slate-900');
                } else {
                    section.classList.add('hidden');
                    btn.classList.remove('tab-active');
                    btn.classList.add('text-slate-600', 'hover:text-slate-900');
                }
            });

            if (tabName === 'practice' && !currentPracticeProblem) {
                generatePracticeProblem();
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ==========================================
        // TRENAJYOR (PRACTICE GENERATOR) LOGIC
        // ==========================================
        function setDifficulty(diff) {
            currentDifficulty = diff;
            ['easy', 'medium', 'hard'].forEach(d => {
                const btn = document.getElementById(`diff-${d}`);
                if (d === diff) {
                    btn.className = 'diff-btn px-4 py-2 rounded-lg text-sm font-bold transition-all bg-white text-indigo-700 shadow-sm';
                } else {
                    btn.className = 'diff-btn px-4 py-2 rounded-lg text-sm font-bold transition-all text-slate-600 hover:text-slate-900';
                }
            });
            generatePracticeProblem();
        }

        function randInt(min, max) {
            return Math.floor(Math.random() * (max - min + 1)) + min;
        }

        function randNonZero(min, max) {
            let n = 0;
            while (n === 0) n = randInt(min, max);
            return n;
        }

        function formatSigned(num, isFirst = false, variable = '') {
            if (num === 0) return '';
            const absVal = Math.abs(num);
            const coeffStr = (variable && absVal === 1) ? '' : absVal;
            if (isFirst) {
                return (num < 0 ? '−' : '') + coeffStr + variable;
            }
            return (num < 0 ? ' − ' : ' + ') + coeffStr + variable;
        }

        function normalizeMathString(str) {
            return str
                .toLowerCase()
                .replace(/\s+/g, '')
                .replace(/−/g, '-')
                .replace(/–/g, '-')
                .replace(/^x=/, '');
        }

        function generatePracticeProblem() {
            // Reset UI
            document.getElementById('practice-input').value = '';
            document.getElementById('practice-feedback').classList.add('hidden');
            document.getElementById('practice-steps-box').classList.add('hidden');
            document.getElementById('practice-input').focus();

            if (currentDifficulty === 'easy') {
                // Oson: O'xshash hadlarni ixchamlash (ax + b + cx + d)
                const a = randNonZero(-8, 9);
                let c = randNonZero(-8, 9);
                if (a + c === 0) c += 2; // 0x bo'lib qolmasligi uchun
                const b = randNonZero(-10, 10);
                const d = randNonZero(-10, 10);

                const sumX = a + c;
                const sumConst = b + d;

                const expr = `${formatSigned(a, true, 'x')}${formatSigned(b, false)}${formatSigned(c, false, 'x')}${formatSigned(d, false)}`;
                let ans = `${formatSigned(sumX, true, 'x')}${formatSigned(sumConst, false)}`;
                if (sumConst === 0) ans = `${formatSigned(sumX, true, 'x')}`;

                currentPracticeProblem = {
                    type: 'simplify',
                    badge: 'Oson • O\'xshash hadlar',
                    instruction: 'O\'xshash hadlarni ixchamlang:',
                    inputLabel: 'Soddalashgan ifodani yozing (masalan: 5x + 3 yoki 4x - 2):',
                    problemText: expr,
                    answer: ans,
                    steps: [
                        `1. Noma'lumli (x li) hadlarni bir guruhga, sonlarni alohida guruhga ajratamiz: <strong>(${formatSigned(a, true, 'x')}${formatSigned(c, false, 'x')}) + (${b}${formatSigned(d, false)})</strong>`,
                        `2. Koeffitsiyentlarni hisoblaymiz: <strong>${a}${formatSigned(c, false)} = ${sumX}</strong> (demak, <strong>${formatSigned(sumX, true, 'x')}</strong>)`,
                        `3. Ozod hadlarni hisoblaymiz: <strong>${b}${formatSigned(d, false)} = ${sumConst}</strong>`,
                        `4. Natija: <strong class="text-indigo-700">${ans}</strong>`
                    ]
                };

            } else if (currentDifficulty === 'medium') {
                // O'rta: Qavslarni ochish va ixchamlash: k(ax + b) + m(cx + d)
                const k = randInt(2, 5);
                const a = randInt(1, 4);
                const b = randNonZero(-6, 6);
                const m = randNonZero(-4, -2); // Manfiy ko'paytuvchi bilan mashq qilish
                const c = randInt(1, 3);
                const d = randNonZero(-6, 6);

                const expr = `${k}(${formatSigned(a, true, 'x')}${formatSigned(b, false)}) − ${Math.abs(m)}(${formatSigned(c, true, 'x')}${formatSigned(d, false)})`;

                const t1x = k * a;
                const t1c = k * b;
                const t2x = m * c;
                const t2c = m * d;

                const finalX = t1x + t2x;
                const finalC = t1c + t2c;

                let ans = '';
                if (finalX !== 0 && finalC !== 0) {
                    ans = `${formatSigned(finalX, true, 'x')}${formatSigned(finalC, false)}`;
                } else if (finalX !== 0) {
                    ans = `${formatSigned(finalX, true, 'x')}`;
                } else {
                    ans = `${finalC}`;
                }

                currentPracticeProblem = {
                    type: 'simplify',
                    badge: 'O\'rta • Qavslarni ochish',
                    instruction: 'Qavslarni oching va ifodani soddalashtiring:',
                    inputLabel: 'Yakuniy soddalashgan ifodani kiriting:',
                    problemText: expr,
                    answer: ans,
                    steps: [
                        `1. Birinchi qavsni ${k} ga ko'paytirib ochamiz: <strong>${formatSigned(t1x, true, 'x')}${formatSigned(t1c, false)}</strong>`,
                        `2. Ikkinchi qavsni <strong>${m}</strong> ga ko'paytirib ochamiz (ishoralarga e'tibor bering!): <strong>${formatSigned(t2x, true, 'x')}${formatSigned(t2c, false)}</strong>`,
                        `3. O'xshash hadlarni ixchamlaymiz: <strong>(${t1x}${formatSigned(t2x, false)})x + (${t1c}${formatSigned(t2c, false)})</strong>`,
                        `4. Yakuniy javob: <strong class="text-indigo-700">${ans}</strong>`
                    ]
                };

            } else {
                // Qiyin: Chiziqli tenglama: k(x + a) + b = cx + d
                const xSol = randNonZero(-7, 8);
                const k = randInt(2, 5);
                const a = randNonZero(-5, 5);
                const c = randInt(1, k - 1); // k != c bo'lishi kafolatlanadi
                const b = randNonZero(-8, 8);

                // Tenglik o'rinli bo'lishi uchun d ni hisoblaymiz: k(xSol + a) + b = c*xSol + d
                const d = k * (xSol + a) + b - c * xSol;

                const leftSide = `${k}(x${formatSigned(a, false)})${formatSigned(b, false)}`;
                const rightSide = `${formatSigned(c, true, 'x')}${formatSigned(d, false)}`;
                const expr = `${leftSide} = ${rightSide}`;

                const step1Const = k * a + b;
                const diffCoeff = k - c;
                const rightConst = d - step1Const;

                currentPracticeProblem = {
                    type: 'equation',
                    badge: 'Qiyin • Chiziqli tenglama',
                    instruction: 'Tenglamani yeching (x ning qiymatini toping):',
                    inputLabel: 'x ning qiymatini kiriting (masalan: 4 yoki -3):',
                    problemText: expr,
                    answer: String(xSol),
                    steps: [
                        `1. Chap tomondagi qavsni ochamiz: <strong>${k}x${formatSigned(k * a, false)}${formatSigned(b, false)} = ${rightSide}</strong>`,
                        `2. Chap tomondagi sonlarni ixchamlaymiz: <strong>${k}x${formatSigned(step1Const, false)} = ${rightSide}</strong>`,
                        `3. Noma'lumli hadlarni chapga, sonlarni o'ngga qarama-qarshi ishora bilan o'tkazamiz: <strong>${k}x − ${c}x = ${d}${formatSigned(-step1Const, false)}</strong>`,
                        `4. Soddalashtiramiz: <strong>${diffCoeff}x = ${rightConst}</strong>`,
                        `5. Ikkala tomonni ${diffCoeff} ga bo'lamiz: <strong class="text-emerald-700">x = ${xSol}</strong>`
                    ]
                };
            }

            document.getElementById('practice-type-badge').textContent = currentPracticeProblem.badge;
            document.getElementById('practice-instruction').textContent = currentPracticeProblem.instruction;
            document.getElementById('practice-input-label').textContent = currentPracticeProblem.inputLabel;
            document.getElementById('practice-problem-text').textContent = currentPracticeProblem.problemText;
            document.getElementById('practice-steps-list').innerHTML = currentPracticeProblem.steps
                .map(s => `<div class="p-2.5 bg-white rounded-lg border border-indigo-100/80">${s}</div>`)
                .join('');
        }

        function checkPracticeAnswer(e) {
            e.preventDefault();
            const rawInput = document.getElementById('practice-input').value.trim();
            const feedbackEl = document.getElementById('practice-feedback');

            if (!rawInput) {
                feedbackEl.className = 'mt-5 p-4 rounded-xl border border-amber-200 bg-amber-50 text-amber-800 font-medium text-sm flex items-center gap-3';
                feedbackEl.innerHTML = `<i data-lucide="alert-circle" class="w-5 h-5 text-amber-600 shrink-0"></i><span>Iltimos, avval javobingizni kiriting!</span>`;
                feedbackEl.classList.remove('hidden');
                lucide.createIcons();
                return;
            }

            const userNorm = normalizeMathString(rawInput);
            const correctNorm = normalizeMathString(currentPracticeProblem.answer);

            // Qo'shimcha ekvivalent yozuvlarni tekshirish (masalan: 3+5x va 5x+3)
            let isCorrect = (userNorm === correctNorm);
            if (!isCorrect && currentPracticeProblem.type === 'simplify') {
                // Agar "b + ax" ko'rinishida yozgan bo'lsa
                const parts = correctNorm.match(/^([+-]?\d*x)([+-]\d+)$/);
                if (parts) {
                    const altForm = normalizeMathString(`${parts[2]}${parts[1].startsWith('-') ? parts[1] : '+' + parts[1]}`);
                    if (userNorm === altForm) isCorrect = true;
                }
            }

            if (isCorrect) {
                const earned = currentDifficulty === 'easy' ? 5 : (currentDifficulty === 'medium' ? 10 : 15);
                addScore(earned);
                practiceSolvedCount++;
                document.getElementById('practice-solved-count').textContent = practiceSolvedCount;

                feedbackEl.className = 'mt-5 p-4 rounded-xl border border-emerald-200 bg-emerald-50 text-emerald-800 font-semibold text-sm flex items-center justify-between gap-3';
                feedbackEl.innerHTML = `
                    <div class="flex items-center gap-3">
                        <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-600 shrink-0"></i>
                        <span>Barakalla! To'g'ri javob (+${earned} ball)</span>
                    </div>
                    <button type="button" onclick="generatePracticeProblem()" class="px-3 py-1.5 bg-emerald-600 text-white rounded-lg text-xs font-bold hover:bg-emerald-700">
                        Keyingisi →
                    </button>
                `;
            } else {
                feedbackEl.className = 'mt-5 p-4 rounded-xl border border-rose-200 bg-rose-50 text-rose-800 font-medium text-sm flex items-center gap-3';
                feedbackEl.innerHTML = `
                    <i data-lucide="x-circle" class="w-5 h-5 text-rose-600 shrink-0"></i>
                    <span>Xato javob. Ishoralarni yoki hisob-kitobni qayta tekshiring, yoki <strong>"Yechimni ko'rsatish"</strong> tugmasidan foydalaning.</span>
                `;
            }

            feedbackEl.classList.remove('hidden');
            lucide.createIcons();
        }

        function togglePracticeSteps() {
            const box = document.getElementById('practice-steps-box');
            box.classList.toggle('hidden');
        }

        // ==========================================
        // TEST SINOVI (10-QUESTION QUIZ) LOGIC
        // ==========================================
        const quizQuestions = [
            {
                category: "O'xshash hadlarni ixchamlash",
                question: "Ifodani soddalashtiring: 7a − 12a + 4a − 5",
                options: ["−a − 5", "a − 5", "−9a − 5", "−a + 5"],
                correct: 0,
                explanation: "O'xshash hadlarni qo'shamiz: (7 − 12 + 4)a = −1a = −a. Ozod had −5 o'zgarishsiz qoladi. Javob: −a − 5."
            },
            {
                category: "Qavslarni ochish",
                question: "Qavslarni oching va ixchamlang: 10 − (3x − 4)",
                options: ["6 − 3x", "14 − 3x", "14 + 3x", "6 + 3x"],
                correct: 1,
                explanation: "Qavs oldida manfiy (−) ishora turgani uchun ichidagi ishoralar o'zgaradi: 10 − 3x + 4 = (10 + 4) − 3x = 14 − 3x."
            },
            {
                category: "Taqsimot qonuni",
                question: "Ifodani soddalashtiring: −3(2y − 5) + 6y",
                options: ["12y − 15", "−15", "15", "12y + 15"],
                correct: 2,
                explanation: "−3 ni qavs ichiga ko'paytiramiz: −6y + 15 + 6y. Bu yerda −6y va +6y o'zaro yo'qoladi (0 bo'ladi), natijada 15 qoladi."
            },
            {
                category: "Chiziqli tenglama",
                question: "Tenglamani yeching: 5x − 8 = 2x + 13",
                options: ["x = 5", "x = 7", "x = −7", "x = 3"],
                correct: 1,
                explanation: "2x ni chapga (−2x), −8 ni o'ngga (+8) o'tkazamiz: 5x − 2x = 13 + 8 ⇒ 3x = 21 ⇒ x = 7."
            },
            {
                category: "Qavsli tenglama",
                question: "Tenglamani yeching: 4(x − 2) = 2(x + 3)",
                options: ["x = 7", "x = 1", "x = −1", "x = 5"],
